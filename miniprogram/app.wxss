page {
  background-color: #FFF8F0;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
               'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  color: #3D2E1A;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.container {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

.card-glass {
  background: #FFFFFF;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  border: 1rpx solid #EDE4D8;
  padding: 24rpx;
  margin: 16rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.primary-gradient {
  background: linear-gradient(135deg, #FF8C00, #E85D00);
}

.primary-gradient-text {
  background: linear-gradient(135deg, #FF8C00, #E85D00);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.btn-primary {
  background: linear-gradient(135deg, #FF8C00, #E85D00);
  color: #FFFFFF;
  border-radius: 60rpx;
  font-weight: 600;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 0, 0.3);
}

.btn-outline {
  background: transparent;
  color: #FF8C00;
  border: 2rpx solid #FF8C00;
  border-radius: 60rpx;
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.text-xs { font-size: 22rpx; }
.text-sm { font-size: 26rpx; }
.text-md { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-xxl { font-size: 48rpx; }

.text-primary { color: #FF8C00; }
.text-secondary { color: #9B8B76; }
.text-white { color: #FFFFFF; }
.text-success { color: #00E676; }
.text-warning { color: #FFD740; }
.text-danger { color: #FF5252; }

.font-normal { font-weight: 400; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }

.block { display: block; }
.text-center { text-align: center; }

.mt-4 { margin-top: 4rpx; }
.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-8 { margin-left: 8rpx; }
.ml-12 { margin-left: 12rpx; }
.ml-16 { margin-left: 16rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-12 { margin-right: 12rpx; }

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.tag-success {
  background: rgba(0, 230, 118, 0.15);
  color: #00E676;
}

.tag-warning {
  background: rgba(255, 215, 64, 0.15);
  color: #FFD740;
}

.divider {
  width: 100%;
  height: 1rpx;
  background: #EDE4D8;
  margin: 16rpx 0;
}

.shadow-glow {
  box-shadow: 0 0 30rpx rgba(255, 140, 0, 0.2);
}

.rounded-full {
  border-radius: 50%;
}
