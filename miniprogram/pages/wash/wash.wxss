.top-bar {
  padding: 10rpx 0 20rpx;
}

.bar-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 蓝牙状态 */
.ble-status {
  margin: 0 0 20rpx;
  padding: 20rpx 24rpx;
}

.ble-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-connected {
  background: #00E676;
  box-shadow: 0 0 12rpx rgba(0, 230, 118, 0.6);
  animation: pulse 2s infinite;
}

.dot-disconnected {
  background: #FF5252;
  box-shadow: 0 0 12rpx rgba(255, 82, 82, 0.6);
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.btn-small {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border-radius: 24rpx;
  border: none;
}

.section {
  margin: 30rpx 0 20rpx;
}

.section-title {
  color: #3D2E1A;
}

.package-card {
  margin: 12rpx 0;
  padding: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.package-card.package-active {
  border-color: #FF8C00;
  background: rgba(255, 140, 0, 0.06);
}

.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #3D2E1A;
}

.check-circle.checked {
  background: #FF8C00;
  border-color: #FF8C00;
  color: #FFF;
}

.coupon-bar {
  padding: 20rpx 24rpx;
  margin: 0 0 20rpx;
}

.coupon-item {
  margin: 12rpx 0;
  padding: 20rpx 24rpx;
  border: 2rpx solid transparent;
}

.coupon-item.coupon-active {
  border-color: #FF8C00;
  background: rgba(255, 140, 0, 0.06);
}

.step-card {
  margin: 12rpx 0;
  padding: 20rpx 24rpx;
}

.step-emoji {
  font-size: 36rpx;
  width: 44rpx;
  text-align: center;
}

.step-controls {
  display: flex;
  align-items: center;
}

.ctrl-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F5EDE4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #FF8C00;
}

.ctrl-count {
  margin: 0 16rpx;
  min-width: 30rpx;
  text-align: center;
}

.add-step-btn {
  padding: 16rpx;
  border-radius: 16rpx;
  border: 1rpx dashed rgba(0,0,0,0.15);
}

.summary-card {
  padding: 24rpx;
  margin: 20rpx 0;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 40rpx;
}

/* 进度条 */
.progress-section {
  margin: 30rpx 0 40rpx;
}

.progress-bar-container {
  width: 100%;
  height: 20rpx;
  background: #EDE4D8;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF8C00, #E85D00);
  border-radius: 10rpx;
  transition: width 1s ease;
}

/* 预约选项 */
.booking-option {
  margin: 0;
}

/* UV 消毒附加项 */
.uv-option {
  margin: 0;
  padding: 20rpx 24rpx;
}

/* 开发测试折叠区 */
.diag-header {
  padding: 20rpx 24rpx;
  border: 1rpx dashed rgba(255, 140, 0, 0.35);
}

.diag-body {
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
}

.diag-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.12);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.06);
  color: #d7e3f5;
  border: 1rpx solid rgba(90, 160, 255, 0.4);
  border-radius: 12rpx;
}

.btn-ghost[disabled] {
  opacity: 0.4;
  color: #8a97ab;
}

.btn-ghost.active {
  background: rgba(90, 160, 255, 0.18);
  color: #9cc8ff;
  border-color: rgba(90, 160, 255, 0.7);
}

.booking-time-section {
  /* 预约时间选择区域 */
}

.picker-display {
  background: #FFF5EB;
  border: 1rpx solid #EDE4D8;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.booking-preview {
  text-align: center;
}

.mt-4 { margin-top: 4rpx; }
.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-8 { margin-left: 8rpx; }
.ml-12 { margin-left: 12rpx; }
.ml-16 { margin-left: 16rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-12 { margin-right: 12rpx; }
