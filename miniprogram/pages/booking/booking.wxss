.container {
  padding: 20rpx 30rpx 40rpx;
}

.mb-12 { margin-bottom: 12rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mr-12 { margin-right: 12rpx; }

.tabs {
  gap: 12rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 30rpx;
  background: #F5EDE4;
  color: #9B8B76;
  font-size: 26rpx;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF8C00, #E85D00);
  color: #FFFFFF;
}

.booking-card {
  margin: 16rpx 0;
  padding: 24rpx;
}

.booking-info {
  background: #FAFAF5;
  border-radius: 16rpx;
  padding: 16rpx;
}

.progress-bar-mini {
  width: 100%;
  height: 6rpx;
  background: #EDE4D8;
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF8C00, #E85D00);
  border-radius: 3rpx;
}

.action-btn {
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  border-radius: 24rpx;
  border: none;
}

.empty-state {
  padding-top: 120rpx;
}

.welfare-entry {
  padding: 24rpx;
  margin-top: 30rpx;
}

.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-column { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

/* 修改时间弹窗 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.time-picker-dialog {
  width: 85%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(60rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.picker-display {
  background: #F5EDE4;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
}
