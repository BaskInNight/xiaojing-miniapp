.login-container {
  min-height: 100vh;
  background: var(--bg-primary, #FFF8F0);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.app-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary, #3D2E1A);
  display: block;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: var(--text-secondary, #9B8B76);
  display: block;
}

/* 头像选择 */
.avatar-section {
  margin-bottom: 40rpx;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #EDE4D8;
  border: 4rpx solid rgba(0,0,0,0.06);
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #EDE4D8;
  border: 4rpx dashed rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder-icon {
  font-size: 48rpx;
  color: rgba(0,0,0,0.2);
  line-height: 1;
}

.avatar-hint {
  font-size: 24rpx;
  color: var(--text-secondary, #9B8B76);
  margin-top: 12rpx;
  display: block;
}

/* 昵称输入 */
.nickname-section {
  width: 60%;
  margin-bottom: 50rpx;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  background: #FFF5EB;
  border: 2rpx solid rgba(0,0,0,0.06);
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--text-primary, #3D2E1A);
}

.nickname-placeholder {
  color: rgba(0,0,0,0.2);
  font-size: 28rpx;
}

.login-body {
  width: 100%;
  margin-bottom: 40rpx;
}

.agreement-box {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.agree-checkbox {
  transform: scale(0.8);
  margin-right: 8rpx;
}

.login-btn-section {
  width: 100%;
  margin-bottom: 60rpx;
}

.primary-gradient {
  background: linear-gradient(135deg, #FF8C00, #E85D00);
  color: #fff;
}

.btn-disabled {
  background: #EDE4D8;
  color: var(--text-secondary, #9B8B76);
  opacity: 0.5;
}

.wechat-login-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}

.skip-btn {
  width: 100%;
  height: 80rpx;
  background: transparent;
  border: none;
  font-size: 28rpx;
  color: var(--text-secondary, #9B8B76);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-footer {
  text-align: center;
}

.mt-4 { margin-top: 4rpx; }
