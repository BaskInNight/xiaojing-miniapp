.page-title {
  padding-top: 20rpx;
}

.tabs {
  gap: 12rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 30rpx;
  background: #F5EDE4;
  color: #9B8B76;
  font-size: 24rpx;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF8C00, #E85D00);
  color: #FFFFFF;
}

.order-card {
  margin: 16rpx 0;
  padding: 24rpx;
}

.order-header {
  margin-bottom: 12rpx;
}

.order-info {
  background: #FAFAF5;
  border-radius: 16rpx;
  padding: 16rpx;
}

.order-footer {
  margin-top: 16rpx;
  gap: 12rpx;
  justify-content: flex-end;
}

.action-btn {
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  border-radius: 24rpx;
  border: none;
}

.empty-state {
  padding-top: 120rpx;
}

.loading-more {
  padding: 30rpx 0;
  text-align: center;
}

