.page-title {
  padding-top: 20rpx;
}

.scan-section {
  text-align: center;
}

.scan-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.device-card {
  margin: 12rpx 0;
  padding: 24rpx;
}

.signal-icon {
  font-size: 32rpx;
}

.empty-state {
  padding-top: 60rpx;
}

.tips {
  padding: 20rpx 24rpx;
}

.device-fault-card {
  opacity: 0.6;
  border: 2rpx solid rgba(255, 82, 82, 0.4);
  background: rgba(255, 82, 82, 0.03);
}

.device-fault-card .device-name {
  color: var(--text-secondary, #9B8B76);
}

.mt-4 { margin-top: 4rpx; }
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-8 { margin-left: 8rpx; }
