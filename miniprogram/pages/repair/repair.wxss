.page-title { padding-top: 20rpx; }

.form-card {
  padding: 24rpx;
}

.form-item {
  margin-bottom: 4rpx;
}

.picker-value {
  background: #FFF5EB;
  border: 1rpx solid #EDE4D8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.input-field {
  background: #FFF5EB;
  border: 1rpx solid #EDE4D8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: #3D2E1A;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.textarea-field {
  background: #FFF5EB;
  border: 1rpx solid #EDE4D8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: #3D2E1A;
  font-size: 28rpx;
  width: 100%;
  height: 200rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.contact-card {
  padding: 24rpx;
}
